{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "frontend/**/*.js",
    "scripts/**/*.js",
    "hardhat.config.js",
    "playwright.config.js",
    "e2e/**/*.js",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "artifacts",
    "cache",
    "frontend/src"
  ]
}
